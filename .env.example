# Placeholder for a future backend. The current build needs no environment
# variables: all data is mocked in src/data/mock.js.
# VITE_API_BASE_URL=https://hrms-api.example.internal

# Live holiday sync from Google Calendar (optional).
# Google Cloud Console -> enable "Google Calendar API" -> create an API key,
# restricted by HTTP referrer and to the Calendar API. Public holiday calendars
# need no OAuth. Without this the app uses the bundled 2026 DoPT list.
# VITE_GOOGLE_API_KEY=your_api_key_here

# Public demo build: shows a demo banner and neutral branding so the deployed
# site is never mistaken for the live HR portal. Leave unset for local work.
# VITE_PUBLIC_DEMO=true
